@media screen and (max-width: 620px) {

    /* 3 row RWD */
    body.fso_location table.mdTableCol3 td[data-label]:after {
        content: " (" attr(data-label) ")";
        font-size: 0.8em;
    }

    body.fso_location table.mdTableCol3 tr {
        display: flex;
        flex-wrap: wrap;
    }

    body.fso_location table.mdTableCol3 td:nth-child(n+2) {
        min-width: 50%;
    }

    body.fso_location table.mdTableCol3 td:first-child {
        width: 100%;
        font-weight: bold;
    }

    body.fso_location table.mdTableCol3 th {
        display: none;
    }

    #flexslider-mdts.flexslider .slides .cover img[data-cover=true] {
        height: auto;
    }

    /* remove padding of the image */
    body.fso_location .mDocSlider {
        padding: 0;
    }

    body.fso_location .mDocMainSlider .flex-direction-nav a.flex-next,
    body.fso_location .mDocMainSlider .flexslider:hover .flex-direction-nav a.flex-next {
        right: -9999px;
        /* hide the button */
    }

    body.fso_location .mDocMainSlider .flex-direction-nav a.flex-prev,
    body.fso_location .mDocMainSlider .flexslider:hover .flex-direction-nav a.flex-prev {
        left: -9999px;
        /* hide the button */
    }

}

body.fso_location {
    --smargin: 0.125rem;
    --margin: 0.25rem;
    --lmargin: 0.5rem;
    --xlmargin: 1rem;
}

body.fso_location .cont .flexTitleList>div>div:nth-child(1) body.fso_location .cont ul>li {
    margin-bottom: 0;
}

body.fso_location .cont table {
    width: auto;
    max-width: 100%;
    min-width: 80%;
}

body.fso_location .cont table th,
body.fso_location .cont table td {
    padding: var(--smargin) 3rem var(--margin) 0rem;
}

body.fso_location .cont table th:last-child,
body.fso_location .cont table td:last-child {
    padding-right: 0;
}

body.fso_location .mDocTitleList .cont table {
    margin-bottom: 2em;
}

body.fso_location td>li {
    margin-left: var(--xlmargin);
}

body.fso_location td>li:last-child {
    margin-bottom: var(--lmargin);
}

body.fso_location .cont p~ul,
body.fso_location .cont p~ol {
    margin-top: -1em;
}

body.fso_location .mDocDetail .cont ul>li,
body.fso_location .cont li>ul,
body.fso_location .cont li>ol {
    margin-bottom: var(--margin);
}

.mDocDetail .cont :not(.myIcon)>a.externalUrl {
