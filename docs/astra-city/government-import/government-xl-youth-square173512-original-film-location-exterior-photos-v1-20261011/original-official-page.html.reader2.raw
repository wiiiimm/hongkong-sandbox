    <script>
        $(function () { 
            replaceLastRevisionDate(); 
        });

        function replaceLastRevisionDate() {
            var last_post_date = '20 November 2023';
            last_revision_date_r = $(".updateDate").text().split(': ');
            origin_str = last_revision_date_r[0];
            if(lang == 0) {
                $(".updateDate").text(origin_str + ': ' + last_post_date);
            } else {
                var temp_post_date = new Date('2023-11-20 17:13:14');
                var year = temp_post_date.getFullYear();
                var month = temp_post_date.getMonth() + 1;
                var date = temp_post_date.getDate();
                var formattedDate = year+'年'+month+'月'+date+'日';
                $(".updateDate").text(origin_str + ': ' + formattedDate);
            }
        }
    </script>
