    body.fso_location thead>tr {
        left: -9999px;
        position: absolute;
    }
}

.headingWith {
    translate: 0rem 0rem;
    transition: translate 0.2s ease-in;
}

.fixedHeader .headingWith {
    position: fixed;
    z-index: 9999999999999;
    top: 0;
    left: 0;
    padding: 1rem 1.5rem 1rem 4rem;
    translate: -2rem 5.5rem;
    border-radius: 2rem;
    background-color: white;
    -webkit-box-shadow: 3px 3px 14px -6px rgba(0, 0, 0, 0.56);
    -moz-box-shadow: 3px 3px 14px -6px rgba(0, 0, 0, 0.56);
    box-shadow: 3px 3px 14px -6px rgba(0, 0, 0, 0.56);
    min-width:20vw;
    max-width:390px;
}

.fixedHeader .headingWith .h2 {
    font-size: 1.75rem;
}
.englishVersion.fixedHeader .headingWith .h2 {
    font-size: 1.5rem;
}


.fixedHeader .mainContent .headingWith p {
    margin-bottom: 0px;
    margin-top: 0.5rem;
    display: flex;
    justify-content: space-between;
    flex-direction: column;
    gap: 0.5rem;
}

.mainArea .headingWith a.tel {
    display: none;
}
.fixedHeader .mainArea .headingWith a.tel {
    display: block;
    white-space: nowrap;
}
.fixedHeader .myDocumentContent {
    margin-top: 20rem;
}
.mainArea .headingWith a.tel:before {
    background-image: url(../../images/icon/icon_tel.svg);
    background-size: 1rem;
}
.fixedHeader .mainArea .headingWith a.mi_location {
    padding: 0 1rem 0rem 2rem;
}
@media screen and (max-width: 750px) {
    body.fixedHeader .mainContent .headingWith p {
        flex-direction: row;
    }
    body.fixedHeader .mainArea .headingWith a.mi_location {
        padding: 0 0.5rem 0rem 2rem;
    }

    body.fixedHeader .headingWith {
        translate: 0rem 5rem;
        border-radius: 0rem;
        min-width:20vw;
        max-width:100%;
        width: 100%;
        padding: 1rem 1rem 1rem 1rem;
    }
}
