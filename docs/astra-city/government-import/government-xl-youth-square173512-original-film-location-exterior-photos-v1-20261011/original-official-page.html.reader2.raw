    <script type="text/javascript">
        
var menu_id = '0';
var section_id = '2022100717014066248';

                                                                                       $( window ).on( "load", function() {
    // add classes to markdown generated table
    [...document.querySelectorAll('.mDocTitleList table')].forEach(table=>{
        const th = table.querySelectorAll("thead th");
        if(!th) return;
        if(!th[0].parentElement.innerText) 
            table.classList.add("emptyHeader"); // add .emptyHeader for future styling ctrl.
        else {
            // add data-label to respective tds
            [...th].forEach((header,i)=>{
                [...table.querySelectorAll('td:nth-child('+(i+1)+')')].forEach(td=>{
                    if(header.innerText && td.innerText) td.dataset.label=header.innerText 
                });
            })
        }
        //const numOfColumns = th.length;
        table.classList.add("mdTableCol"+th.length) // .mdTableCol3, .mdTableCol2   
    });
    if($("#flexslider-mdts ul>li").length == 1) {
      $("#flexslider-mdts").hide();
      $(".mDocSlider").addClass("onePic");
    }
    // add class to images. within 10% ratio diff is fine.
    function setCover(img, targetRatio) {
        const ratio = (img.naturalWidth/ img.naturalHeight) || (img.width / img.height);
        img.dataset.cover = (ratio > targetRatio*0.8 && ratio < targetRatio*1.2);
    }
    $(".mDocMainSlider .cover img").each((i,img)=>{
      setCover(img, 1.78);
    });
    $(".mDocThumbSlider .cover img").each((i,img)=>{
      setCover(img, 1.5);
    });
    
    timer = window.setTimeout(()=>{
        scrollToAnchor();
    },500);
});
let timer;
function loadedImg(i) {
    if(timer) window.clearTimeout(timer);
    scrollToAnchor();
}



  function scrollToTargetAdjusted(targetElement) {
        var element = document.querySelector(targetElement);
      var headerOffset = 130;
        var elementPosition = element.getBoundingClientRect().top;
      var offsetPosition = elementPosition + window.pageYOffset - headerOffset;
      
      window.scrollTo({
          top: offsetPosition,
          behavior: "smooth"
      });   
  }
    </script>
