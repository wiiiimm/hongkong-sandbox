@media screen and (max-width: 750px) {

    /* 3 row RWD */
    body.fso_location .cont table.mdTableCol3 {
        width: 100%;
    }

    body.fso_location table.mdTableCol3 td[data-label]:after {
        content: " (" attr(data-label) ")";
        font-size: 0.9em;
    }

    body.fso_location table.mdTableCol3 tr {
        display: flex;
        flex-direction: column;
    }

    body.fso_location .cont table th,
    body.fso_location .cont table td {
        padding: var(--margin);
    }

    body.fso_location .cont table td:first-child {
        padding-right: var(--xlmargin);
    }

    body.fso_location table.mdTableCol3 td[colspan][data-label]:after {
        content: "";
    }

    body.fso_location table.mdTableCol3 td[colspan][data-label] center {
        text-align: left;
    }

    body.fso_location table.mdTableCol3 td:nth-child(n+2) {
        display: list-item;
        margin-left: 1em;
        list-style-type: circle
    }

    body.fso_location table.mdTableCol3 td:first-child {
        margin-top: var(--margin);
    }

    body.fso_location table.mdTableCol3 td:last-child {
        padding-bottom: 1em;
    }

    body.fso_location table.mdTableCol3 thead>tr {
        left: -9999px;
        position: absolute;
    }

    #flexslider-mdts.flexslider .slides .cover img[data-cover=true] {
        height: auto;
    }

    /* remove padding of the image */
    body.fso_location .mDocSlider {
        padding: 0;
    }

    body.fso_location .mDocMainSlider .flex-direction-nav a.flex-next,
    body.fso_location .mDocMainSlider .flexslider:hover .flex-direction-nav a.flex-next {
        right: -9999px;
        /* hide the button */
    }

    body.fso_location .mDocMainSlider .flex-direction-nav a.flex-prev,
    body.fso_location .mDocMainSlider .flexslider:hover .flex-direction-nav a.flex-prev {
        left: -9999px;
        /* hide the button */
    }
}


@media screen and (max-width: 450px) {
    body.fso_location.chineseVersion .flexTitleList>div>div:nth-child(1) {
        min-width: 5em;
        width: 5em;
    }

    body.fso_location.englishVersion .flexTitleList>div>div:nth-child(1) {
