# We work across multiple devices and sandboxes, so ALL project files
# (app, scripts, docs, references, data, meshes) are committed.
# Only truly local / regeneratable dev cruft is ignored below.

# === OS / editor cruft ===
.DS_Store
**/.DS_Store
*.swp
Thumbs.db

# === Python (regeneratable) ===
__pycache__/
*.pyc
venv/
.venv/

# === Node / build output (regeneratable) ===
node_modules/
dist/
.vercel/

# === Secrets / local env (must stay local) ===
.env
.env.*
!.env.example

# wrangler local cache/state (never commit — may hold account info)
.wrangler/

# HKS-84 sky data prep: the 53 MB Hipparcos main catalogue is fetched on
# demand by source-scripts/hk-sky/build_hk_sky.mjs — too big to commit;
# the smaller cached sources (BSC5, constellationship.fab) ARE committed.
source-scripts/hk-sky/cache/hip_main.dat

# HKS buildings layer: the 397 MB LandsD "Building" GeoJSON (CSDI) is fetched on
# demand by source-scripts/hk-buildings/build_hk_buildings.mjs — far too big to
# commit; the compact binary it produces (3d-viewer/data/hk-buildings.bin) IS committed.
source-scripts/hk-buildings/cache/*.geojson
source-scripts/hk-buildings/cache/*.bmp        # PlanD land-utilisation raster tiles (4 × 30 MB), re-exported on demand
# LandsD 5 m DTM (28.7 MB zip / 302 MB ASC) — fetched on demand by source-scripts/hk-5m/build_urban_mesh.mjs
source-scripts/hk-5m/cache/
